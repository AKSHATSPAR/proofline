# Default: free-tier Gemini. Create a key at https://aistudio.google.com/app/apikey.
# Never commit the real key.
PROOFLINE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Use 1 for a public, read-only review deployment. Keep 0 for local PDF processing.
PROOFLINE_DEMO_ONLY=0

# Optional alternative provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional. Defaults to data/proofline.db.
PROOFLINE_DB_PATH=data/proofline.db
